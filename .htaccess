# Hostinger / shared hosting: when the whole repository is deployed into public_html,
# send every request into Laravel's public/ folder so app code, .env, vendor/ and storage/
# are never reachable from the web.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block dotfiles (.env, .git, …) outright.
    RewriteRule (^|/)\.(?!well-known/) - [F,L]

    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>
Options -Indexes
